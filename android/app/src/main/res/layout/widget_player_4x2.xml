<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 player: cover on the left; the right column carries the title, the artist,
  the current lyric line and the playback controls, in that order.

  Flat and monochrome throughout: solid fills, rounded corners, no gradients and
  no accent colours.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/widget_cover_background"
        android:contentDescription="@string/widget_cover"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_action_previous"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />

            <ImageButton
                android:id="@+id/widget_toggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_play_button_background"
                android:contentDescription="@string/widget_action_play"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_filled" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_action_next"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>