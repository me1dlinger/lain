<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 player, following the reference design: cover on the left, title and
  artist on the right, and a centred control row underneath with a filled disc
  behind play/pause. Deliberately flat and monochrome - one solid rounded panel,
  no gradients, no accent colours - and sized so the content still fits the
  smallest 2x2 cell (110dp).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_cover_background"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/widget_empty_title"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_action_previous"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_previous" />

        <ImageButton
            android:id="@+id/widget_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_button_background"
            android:contentDescription="@string/widget_action_play"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play_filled" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_action_next"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_next" />
    </LinearLayout>
</LinearLayout>